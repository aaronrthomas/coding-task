# Brightloop Software Subscription Management System - Supabase Configuration

# 1. Supabase Project Credentials (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Supabase PostgreSQL Database URLs (Found in Project Settings -> Database -> Connection string)
# Transaction pooler mode (port 6543) used for runtime application queries
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session mode / Direct connection (port 5432) used for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 3. Auth and Session Secret (Used for encrypted JWT fallback)
JWT_SECRET="replace-with-a-secure-random-32-char-string"

# 4. Recurring Billing Engine Cron Secret
BILLING_CRON_SECRET="replace-with-a-secure-billing-trigger-secret"

# 5. App URL & Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
