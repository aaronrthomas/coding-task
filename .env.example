# Brightloop Software Subscription Management System
# Database URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:8000/brightloop_db?schema=public"

# Auth and Session Secret
JWT_SECRET="replace-with-a-secure-random-32-char-string"

# Recurring Billing Engine Cron Secret
BILLING_CRON_SECRET="replace-with-a-secure-billing-trigger-secret"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
