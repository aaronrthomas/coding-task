// Brightloop Software - Prisma Schema
// Enterprise Subscription Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  SERVICE
  HARDWARE
  SUBSCRIPTION_TIER
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  CASH
  OTHER
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum BillingRecordStatus {
  SUCCESS
  FAILED
  SKIPPED
}

// User accounts for Authentication & Authorization
model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  name               String
  passwordHash       String
  role               Role         @default(CUSTOMER)
  resetToken         String?
  resetTokenExpiry   DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  customerProfile    Customer?
  recordedPayments   Payment[]    @relation("RecordedPayments")
  statusHistory      SubscriptionStatusHistory[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([role])
}

// Customer Profile
model Customer {
  id              String         @id @default(uuid())
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  email           String         @unique
  companyName     String?
  phone           String?
  billingAddress  String?
  taxId           String?
  isArchived      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  quotations      Quotation[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  payments        Payment[]
  discountUsages  DiscountUsage[]

  @@index([email])
  @@index([name])
  @@index([isArchived])
}

// Products Catalog
model Product {
  id             String           @id @default(uuid())
  name           String
  type           ProductType      @default(SOFTWARE)
  salesPrice     Decimal          @default(0.00) @db.Decimal(12, 2)
  costPrice      Decimal          @default(0.00) @db.Decimal(12, 2)
  description    String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  variants       ProductVariant[]
  plans          Plan[]
  quotationItems QuotationItem[]
  subscriptionItems SubscriptionItem[]
  invoiceItems   InvoiceItem[]
  taxRules       TaxRuleProduct[]
  discountRules  DiscountRule[]

  @@index([name])
  @@index([isActive])
}

// Product Variants with configurable price adjustment
model ProductVariant {
  id              String         @id @default(uuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Decimal        @default(0.00) @db.Decimal(12, 2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  quotationItems  QuotationItem[]
  subscriptionItems SubscriptionItem[]
  invoiceItems    InvoiceItem[]

  @@index([productId])
  @@index([isActive])
}

// Subscription Plans
model Plan {
  id              String            @id @default(uuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  price           Decimal           @db.Decimal(12, 2)
  billingFrequency BillingFrequency @default(MONTHLY)
  minQuantity     Int               @default(1)
  availableFrom   DateTime?
  availableUntil  DateTime?
  autoClose       Boolean           @default(false)
  canEarlyClose   Boolean           @default(true)
  canPause        Boolean           @default(true)
  canRenew        Boolean           @default(true)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  subscriptions   Subscription[]
  templates       QuotationTemplate[]

  @@index([productId])
  @@index([isActive])
  @@index([billingFrequency])
}

// Quotation Templates
model QuotationTemplate {
  id              String        @id @default(uuid())
  name            String
  description     String?
  defaultPlanId   String?
  defaultPlan     Plan?         @relation(fields: [defaultPlanId], references: [id], onDelete: SetNull)
  validityDays    Int           @default(30)
  templateLinesJson String?     @db.Text
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Quotations
model Quotation {
  id                     String           @id @default(uuid())
  quotationNumber        String           @unique
  customerId             String
  customer               Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status                 QuotationStatus  @default(DRAFT)
  validUntil             DateTime
  notes                  String?
  subtotal               Decimal          @default(0.00) @db.Decimal(12, 2)
  taxTotal               Decimal          @default(0.00) @db.Decimal(12, 2)
  discountTotal          Decimal          @default(0.00) @db.Decimal(12, 2)
  grandTotal             Decimal          @default(0.00) @db.Decimal(12, 2)
  convertedSubscriptionId String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  items                  QuotationItem[]

  @@index([customerId])
  @@index([status])
  @@index([quotationNumber])
}

model QuotationItem {
  id             String          @id @default(uuid())
  quotationId    String
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(0.00) @db.Decimal(5, 2)
  taxAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)

  @@index([quotationId])
  @@index([productId])
}

// Subscriptions
model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime
  expiryDate         DateTime?
  billingFrequency   BillingFrequency
  nextBillingDate    DateTime
  paymentTerms       String             @default("Due upon receipt")
  currency           String             @default("INR")
  subtotal           Decimal            @default(0.00) @db.Decimal(12, 2)
  taxTotal           Decimal            @default(0.00) @db.Decimal(12, 2)
  discountTotal      Decimal            @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal            @default(0.00) @db.Decimal(12, 2)
  autoClose          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              SubscriptionItem[]
  invoices           Invoice[]
  statusHistory      SubscriptionStatusHistory[]
  billingRecords     BillingRecord[]
  discountUsages     DiscountUsage[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
  @@index([subscriptionNumber])
}

model SubscriptionItem {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  subtotal       Decimal         @db.Decimal(12, 2)

  @@index([subscriptionId])
  @@index([productId])
}

model SubscriptionStatusHistory {
  id             String             @id @default(uuid())
  subscriptionId String
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  changedByUserId String?
  changedByUser  User?              @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  @@index([subscriptionId])
}

// Tax Rules
model TaxRule {
  id                    String            @id @default(uuid())
  name                  String
  rate                  Decimal           @db.Decimal(5, 2) // e.g. 18.00 for 18%
  description           String?
  applicableProductType ProductType?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  applicableProducts    TaxRuleProduct[]

  @@index([name])
  @@index([isActive])
}

model TaxRuleProduct {
  id         String   @id @default(uuid())
  taxRuleId  String
  taxRule    TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([taxRuleId, productId])
}

// Discount Rules
model DiscountRule {
  id                  String         @id @default(uuid())
  code                String         @unique
  name                String
  type                DiscountType   @default(PERCENTAGE)
  value               Decimal        @db.Decimal(12, 2)
  minPurchase         Decimal?       @db.Decimal(12, 2)
  minQuantity         Int?
  maxUses             Int?
  currentUses         Int            @default(0)
  startDate           DateTime?
  endDate             DateTime?
  productId           String?
  product             Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  isWholeSubscription Boolean        @default(true)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  usages              DiscountUsage[]

  @@index([code])
  @@index([isActive])
}

model DiscountUsage {
  id             String        @id @default(uuid())
  discountRuleId String
  discountRule   DiscountRule  @relation(fields: [discountRuleId], references: [id], onDelete: Restrict)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appliedAmount  Decimal       @db.Decimal(12, 2)
  usedAt         DateTime      @default(now())

  @@index([discountRuleId])
  @@index([subscriptionId])
  @@index([invoiceId])
}

// Invoices
model Invoice {
  id                 String         @id @default(uuid())
  invoiceNumber      String         @unique
  subscriptionId     String?
  subscription       Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             InvoiceStatus  @default(DRAFT)
  invoiceDate        DateTime       @default(now())
  periodStart        DateTime
  periodEnd          DateTime
  dueDate            DateTime
  subtotal           Decimal        @default(0.00) @db.Decimal(12, 2)
  totalTax           Decimal        @default(0.00) @db.Decimal(12, 2)
  totalDiscount      Decimal        @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal        @default(0.00) @db.Decimal(12, 2)
  amountPaid         Decimal        @default(0.00) @db.Decimal(12, 2)
  outstandingBalance Decimal        @default(0.00) @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items              InvoiceItem[]
  payments           Payment[]
  discountUsages     DiscountUsage[]
  billingRecords     BillingRecord[]

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id             String          @id @default(uuid())
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(0.00) @db.Decimal(5, 2)
  taxAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  lineTotal      Decimal         @db.Decimal(12, 2)

  @@index([invoiceId])
}

// Payments
model Payment {
  id               String        @id @default(uuid())
  paymentReference String        @unique
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount           Decimal       @db.Decimal(12, 2)
  paymentDate      DateTime      @default(now())
  paymentMethod    PaymentMethod @default(BANK_TRANSFER)
  transactionRef   String?
  notes            String?
  recordedByUserId String?
  recordedByUser   User?         @relation("RecordedPayments", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())

  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentReference])
}

// Recurring Billing Execution Records (Idempotent tracking)
model BillingRecord {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  status         BillingRecordStatus
  invoiceId      String?
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  errorMessage   String?
  createdAt      DateTime            @default(now())

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([subscriptionId])
  @@index([status])
}

// Audit Logs
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
